import React, { useState } from 'react';
import {
  View,
  Text,
  TouchableOpacity,
  StyleSheet,
  Alert,
  Platform
} from 'react-native';


import * as DocumentPicker from 'expo-document-picker';
import * as FileSystem from 'expo-file-system/legacy';

export default function UploadJsonScreen() {
  const [status, setStatus] = useState('');
  const [itemsCount, setItemsCount] = useState(0);

  const validateJson = (data) => {
    if (!Array.isArray(data)) {
      throw new Error('JSON must be an array');
    }

    data.forEach((item, index) => {
      if (!item.nameH && !item.nameR) {
        throw new Error(`Item ${index + 1}: missing nameH or nameR`);
      }

      if (!item.date) {
        throw new Error(`Item ${index + 1}: missing date`);
      }

      if (!item.type) {
        throw new Error(`Item ${index + 1}: missing type`);
      }

      if (item.price === undefined) {
        throw new Error(`Item ${index + 1}: missing price`);
      }

      if (!item.image) {
        throw new Error(`Item ${index + 1}: missing image`);
      }
    });

    return true;
  };
const readFileContent = async (file) => {
  if (Platform.OS === 'web') {
    const response = await fetch(file.uri);
    return await response.text();
  }

  return await FileSystem.readAsStringAsync(file.uri);
};



const uploadJson = async () => {
  try {
    const result = await DocumentPicker.getDocumentAsync({
      type: '*/*',
      copyToCacheDirectory: true,
    });

    if (result.canceled) return;

    const file = result.assets[0];

    if (!file?.uri) {
      throw new Error('No file selected');
    }

    console.log('URI:', file.uri);

    let content = await readFileContent(file);

    content = content.replace(/^\uFEFF/, '').trim();

    const parsed = JSON.parse(content);

    if (!Array.isArray(parsed)) {
      throw new Error('JSON must be an array');
    }

    const saveUri = FileSystem.documentDirectory + 'sofashs.json';

    await FileSystem.writeAsStringAsync(
      saveUri,
      JSON.stringify(parsed, null, 2)
    );

    setItemsCount(parsed.length);
    setStatus('JSON uploaded successfully');

    Alert.alert('Success', `Uploaded ${parsed.length} items`);
  } catch (err) {
    console.log('UPLOAD ERROR:', err);
    Alert.alert('Upload failed', err?.message || String(err));
    setStatus(err?.message || 'Upload failed');
  }
};


  return (
    <View style={styles.container}>
      <Text style={styles.title}>Upload JSON</Text>

      <Text style={styles.description}>
        Upload a JSON file with events in the required format.
      </Text>

      <TouchableOpacity style={styles.uploadButton} onPress={uploadJson}>
        <Text style={styles.uploadButtonText}>Upload JSON</Text>
      </TouchableOpacity>

      {status !== '' && <Text style={styles.status}>{status}</Text>}

      {itemsCount > 0 && (
        <Text style={styles.count}>Items uploaded: {itemsCount}</Text>
      )}
    </View>
  );
}

const styles = StyleSheet.create({
  container: {
    flex: 1,
    padding: 20,
    backgroundColor: '#dcfce7',
    justifyContent: 'center',
  },
  title: {
    fontSize: 28,
    fontWeight: '800',
    color: '#064e3b',
    marginBottom: 12,
    textAlign: 'center',
  },
  description: {
    fontSize: 16,
    color: '#14532d',
    textAlign: 'center',
    marginBottom: 24,
  },
  uploadButton: {
    backgroundColor: '#064e3b',
    padding: 16,
    borderRadius: 12,
    alignItems: 'center',
  },
  uploadButtonText: {
    color: '#dcfce7',
    fontSize: 18,
    fontWeight: '700',
  },
  status: {
    marginTop: 20,
    color: '#064e3b',
    fontSize: 16,
    textAlign: 'center',
    fontWeight: '700',
  },
  count: {
    marginTop: 8,
    color: '#166534',
    fontSize: 15,
    textAlign: 'center',
  },
});